# Firebase client (Firebase console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (Google Cloud Console → Credentials → Web client).
# Enable the Drive API. Add redirect URI: https://your-domain/auth/drive/callback
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Server-only — required for Drive OAuth authorization-code + PKCE exchange
GOOGLE_OAUTH_CLIENT_SECRET=

# Firebase Admin (service account JSON — server only, set in Vercel env)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (Dashboard → Developers)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Production site URL (optional; checkout uses the request Origin)
NEXT_PUBLIC_APP_URL=https://ninesixteen.video
