# Firebase client (Firebase console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth (Google Cloud Console → Credentials → Web client).
# Enable the Drive API. Add redirect URI: https://your-domain/auth/drive/callback
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Server-only — required for Drive OAuth authorization-code + PKCE exchange
GOOGLE_OAUTH_CLIENT_SECRET=

# Firebase Admin (service account JSON — server only, set in Vercel env)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (Dashboard → Developers)
# Pro is a single one-time purchase ($49). Create ONE Product with a
# one-off (not recurring) price and paste its price id into STRIPE_PRICE_ID.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Production site URL (optional; checkout uses the request Origin)
NEXT_PUBLIC_APP_URL=https://ninesixteen.video

# Desktop installer — public HTTPS URL to your signed .msi or .exe
## Example: https://github.com/you/ninesixteen/releases/download/v0.1.0/ninesixteen.video_0.1.0_x64-setup.exe
NEXT_PUBLIC_DESKTOP_INSTALLER_URL=
NEXT_PUBLIC_DESKTOP_VERSION=0.1.0
