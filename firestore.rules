rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Signed-in users can read their own entitlement (plan: "trial" = free, "pro" = paying).
      allow read: if request.auth != null && request.auth.uid == uid;
      // All writes go through the server (Admin SDK): sign-in sync + Stripe webhook.
      allow write: if false;
    }
  }
}
